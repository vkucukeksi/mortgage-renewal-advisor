# Set these in the backend process environment; this file is not auto-loaded.
# Resource endpoint, not the Foundry project URL. HTTPS required.
AZURE_OPENAI_ENDPOINT=https://vk-mortgage-advisor-ai.services.ai.azure.com/openai/v1/responses
# Your existing Responses-compatible Azure OpenAI model deployment name.
AZURE_OPENAI_DEPLOYMENT=mortgage-explainer
# Only for a user-assigned identity; omit for system-assigned identity.
# AZURE_CLIENT_ID=your-managed-identity-client-id

# AI safeguards: identical configuration on every process/instance.
# AI fails closed until a private container and valid state blob are provisioned.
AI_QUOTA_ACCOUNT_URL=https://your-existing-account.blob.core.windows.net
AI_QUOTA_CONTAINER=mortgage-ai-guard
AI_QUOTA_BLOB=ai-usage.json
AI_GLOBAL_DAILY_LIMIT=50
# Generate a random secret of at least 32 bytes. Keep it stable across restarts.
AI_VISITOR_HASH_KEY=
# REQUIRED on App Service: exact trusted ingress peers/CIDRs, verified before rollout.
# Never use 0.0.0.0/0 or ::/0. Leave empty for direct local requests.
AI_TRUSTED_PROXY_CIDRS=
# Local Azurite only; do not set a connection string in production.
# AI_QUOTA_CONNECTION_STRING=your-local-azurite-connection-string
# Start Uvicorn with --no-proxy-headers so the application sees the real peer.
